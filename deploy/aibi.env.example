SPRING_PROFILES_ACTIVE=real
SERVER_PORT=8080
AUTH_SESSION_HOURS=12
DB_URL=jdbc:oracle:thin:@//127.0.0.1:1521/AIBIPDB1
DB_USERNAME=aibi
DB_PASSWORD=change-me
FLYWAY_ENABLED=true
AI_MODE=real
AI_CHAT_PROVIDER=ollama
AI_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_TIMEOUT_SECONDS=120
# 千问官方 API。密钥只通过服务器环境变量提供，不要提交到代码仓库。
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
QWEN_API_CHAT_MODEL=qwen3.8-max
QWEN_API_EMBEDDING_MODEL=qwen3.7-text-embedding
QWEN_API_EMBEDDING_DIMENSIONS=1024
QWEN_API_TIMEOUT_SECONDS=120
QDRANT_BASE_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=aibi
QDRANT_VECTOR_SIZE=1024
QUERY_DEFAULT_LIMIT=200
QUERY_MAX_LIMIT=1000
QUERY_TIMEOUT_SECONDS=15
STORAGE_ROOT=/opt/aibi/data/storage
