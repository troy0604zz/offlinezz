# Copy this template to runtime/qwen-api-secret.ps1. Never put a real key in deploy/.
# Use a newly rotated key and the API Host displayed for that key in Model Studio.

$env:DASHSCOPE_API_KEY = 'REPLACE_WITH_NEW_LOCAL_KEY'
$env:QWEN_API_BASE_URL = 'https://dashscope.aliyuncs.com/compatible-mode/v1'
$env:QWEN_API_CHAT_MODEL = 'qwen3.8-max'
$env:QWEN_API_EMBEDDING_MODEL = 'qwen3.7-text-embedding'
$env:QWEN_API_EMBEDDING_DIMENSIONS = '1024'
