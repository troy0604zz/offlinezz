# 无外网环境：使用内网 OpenAI-compatible 模型网关，不部署 Ollama。
SPRING_PROFILES_ACTIVE=real
SERVER_PORT=8080
AUTH_SESSION_HOURS=12

DB_URL=jdbc:oracle:thin:@//oracle-host:1521/service-name
DB_USERNAME=aibi
DB_PASSWORD=change-me
DATASOURCE_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-16-characters
FLYWAY_ENABLED=true

AI_MODE=real
# 当前代码沿用 qwen-api 作为 OpenAI-compatible provider 标识；这里可以指向内网模型网关。
AI_CHAT_PROVIDER=qwen-api
AI_EMBEDDING_PROVIDER=qwen-api
QWEN_API_BASE_URL=http://internal-model-gateway.example.local/v1
# 当前兼容层要求非空 Token。填写内网网关颁发的 Token，不要提交到代码仓库。
DASHSCOPE_API_KEY=change-to-internal-gateway-token
QWEN_API_CHAT_MODEL=change-to-internal-chat-model-id
QWEN_API_EMBEDDING_MODEL=change-to-internal-embedding-model-id
# 必须与内网 Embedding 接口实际返回维度一致。
QWEN_API_EMBEDDING_DIMENSIONS=1024
QWEN_API_TIMEOUT_SECONDS=120

QDRANT_BASE_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=aibi
QDRANT_VECTOR_SIZE=1024

QUERY_DEFAULT_LIMIT=200
QUERY_MAX_LIMIT=1000
QUERY_TIMEOUT_SECONDS=15
STORAGE_ROOT=/opt/aibi/data/storage
