<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <!--
      The repository was prepared through the aliyunmaven mirror. Keeping the
      same mirror id lets Maven Resolver accept the cached artifacts in strict
      offline mode. The URL is never accessed while Maven offline mode is enabled.
    -->
    <mirrors>
        <mirror>
            <id>aliyunmaven</id>
            <name>Offline repository source identity</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>
</settings>
